{
  "name": "badya-weekly-activities",
  "version": "1.0.0",
  "private": true,
  "description": "SAC Sports Hub - Weekly Activities & Student Reservation Platform",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/dev.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run typecheck && vite build --config client/vite.config.ts",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning server/src/db/seed.ts",
    "admin": "node --disable-warning=ExperimentalWarning server/src/cli/admin.ts",
    "demo:public": "node --disable-warning=ExperimentalWarning server/src/cli/public-demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec \"server/test/**/*.test.ts\"",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p client/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.0.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
