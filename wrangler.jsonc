{
  // Cloudflare deployment (free plan): static SPA via Workers Assets + the API in one SQLite-backed Durable Object.
  // Secrets (never commit them): npx wrangler secret put ADMIN_EMAIL / ADMIN_PASSWORD / SHEET_WEBHOOK_URL / SHEET_WEBHOOK_SECRET
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badya-weekly-activities",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppDO"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": {
    "NODE_ENV": "production",
    "APP_TIMEZONE": "Africa/Cairo",
    "UNIVERSITY_EMAIL_DOMAINS": "badyauni.edu.eg",
    "COOKIE_SECURE": "true",
    "ADMIN_NAME": "Sports Office Admin",
    "MAIL_FROM": "SAC Sports Hub <no-reply@badyauni.edu.eg>"
  },
  "observability": { "enabled": true }
}
