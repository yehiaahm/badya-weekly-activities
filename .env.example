# Copy to `.env` and adjust. Every value is optional in development.
# NODE_ENV is set by the npm scripts: `npm run dev` = development, `npm start` = production.

# ---- Server -----------------------------------------------------------------
PORT=4000
# 127.0.0.1 in development, 0.0.0.0 in production by default.
# HOST=0.0.0.0
DATABASE_PATH=data/badya.db
# Set to true when running behind a reverse proxy (nginx, IIS, a load balancer).
TRUST_PROXY=false
# Hosted demos without a persistent disk: load demo data on start-up when the database is empty.
DEMO_DATA=false
# Hosts without a persistent disk: add the SAC "Aerobics & Fitness" kick-off activity on start-up when it is missing.
FEATURED_EVENT=false
# Session cookies are Secure (HTTPS-only) in production. Set to false only for a plain-HTTP intranet.
# COOKIE_SECURE=true
# Development only: the API port the Vite dev server proxies to.
# API_PORT=4000

# ---- Badya rules -------------------------------------------------------------
APP_TIMEZONE=Africa/Cairo
# Registration closes this many working-calendar hours before an activity (Fri/Sat don't count).
REGISTRATION_LEAD_HOURS=24
# Allowed university email domains (comma separated; sub-domains are accepted too).
# Leave empty to accept any email address.
UNIVERSITY_EMAIL_DOMAINS=badyauni.edu.eg

# ---- Staff accounts ----------------------------------------------------------
# The first admin is created on start-up when no admin exists yet.
# Production requires these values. In development, when they are empty, this
# development-only account is created instead:
#   email:    sports.admin@badyauni.edu.eg
#   password: BadyaSports#2026
# More staff (or a password reset): npm run admin -- --email ... --password ...
ADMIN_NAME=Sports Office Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_DAYS=7
STUDENT_SESSION_DAYS=30

# ---- Google Sheet + email (optional) -----------------------------------------
# Google Apps Script web app from integrations/google-sheet/Code.gs. When set, every reservation is
# added to / updated in the Google Sheet, and sign-in codes + confirmations are emailed through it.
# Without it, emails are written to the server log and no sheet is updated.
MAIL_FROM=SAC Sports Hub <no-reply@badyauni.edu.eg>
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
